# =========================================================
# HashProof — Botchain Testnet (Chain ID 968) Configuration
# =========================================================

# 1. Smart Contract Deployment (Hardhat)
# Dedicated Botchain Testnet wallet private key (NEVER use a mainnet key!)
DEPLOYER_PRIVATE_KEY=

# Botchain Testnet RPC Endpoint
BOTCHAIN_RPC_URL=https://rpc.bohr.life

# 2. Frontend Configuration (Vite)
# Deployed HashProofRegistry contract address on Botchain Testnet (Chain ID 968)
# (Also automatically populated in src/config/deployment.json when running `npm run deploy:botchain`)
VITE_CONTRACT_ADDRESS=

# Public RPC Endpoint for read-only verification without wallet connection
VITE_BOTCHAIN_RPC_URL=https://rpc.bohr.life

# Official Botchain Block Explorer (leave empty to disable explorer links)
VITE_BOTCHAIN_EXPLORER_URL=https://scan.bohr.life

# Reown AppKit (WalletConnect) Project ID — obtain free at https://cloud.reown.com
VITE_REOWN_PROJECT_ID=

